/-- All 242 original row certificates on the unchanged literal bank and payment.
This source is a candidate until the full import closure and this theorem compile. -/
theorem f41OriginalAllRows :
    ∀ i : Fin 242,
      neutralNF674OriginalRowCheck
        (neutralNF624Lookup nf690OriginalBank (neutralNF624Index nf690OriginalBank))
        nf702OriginalInputs.payment i = true := by
  intro i
  fin_cases i
  · exact nf702Attach000ActualPayment
