/-- Exactly the original NF673 Boolean receipt, not analytic moment soundness. -/
theorem f41OriginalEntryCheck :
    neutralNF673EntryCheck
      (neutralNF624Lookup nf690OriginalBank (neutralNF624Index nf690OriginalBank))
      nf702OriginalInputs.payment = true :=
  neutralNF674Rows_imply_original_entry _ _ f41OriginalAllRows

/-- Original analytic interval attachment retains the independent moment-soundness premise. -/
theorem f41OriginalEnclosures_of_moment_soundness
    (hM : neutralNF624AllMomentsSound
      (neutralNF624Lookup nf690OriginalBank (neutralNF624Index nf690OriginalBank))) :
    (∀ i j,
      |neutralNF606PhysicalH i j - nf702OriginalInputs.payment.HR i j| ≤
        (nf702OriginalInputs.payment.eH : ℝ)) ∧
    (∀ i j,
      |neutralNF606PhysicalV i j - nf702OriginalInputs.payment.VR i j| ≤
        (nf702OriginalInputs.payment.eV : ℝ)) :=
  neutralNF674Rows_sound _ _ hM f41OriginalAllRows

#print axioms f41OriginalAllRows
#print axioms f41OriginalEntryCheck
#print axioms f41OriginalEnclosures_of_moment_soundness

end WeilDefect
