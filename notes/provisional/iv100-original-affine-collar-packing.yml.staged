      - "WeilDefect/Arithmetic/ActualZetaLiteralFormula.lean"
      - "WeilDefect/Arithmetic/ActualZetaCorrelationInverseAttachment.lean"
      - "WeilDefect/Arithmetic/ActualZetaCorrelationFourierAgreement.lean"
      - "WeilDefect/Arithmetic/ActualZetaCorrelationRegularity.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV089OriginalGammaQuadraticTailGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV086OriginalPhysicalWeilLimitGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaPhaseIVOriginalMixedHermitian.lean"
      - "WeilDefect/Arithmetic/ActualZetaSmoothCorrelationRegularity.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV071GammaFinitePrelude.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV080GammaLinearEnvelopeGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV078FiniteGammaTruncationGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV079GammaDominatedLimitGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV081GammaWeightedCompactC2Gate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV082CompactC2FourierL1Gate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV083CompactC2OriginalGammaLimitGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV084OriginalPolePhysicalGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV085OriginalPrimeFiniteGate.lean"
      - ".github/workflows/iv100-original-affine-collar-packing.yml"
  pull_request:
    paths:
      - "WeilDefect/Arithmetic/ActualZetaIV100OriginalAffineCollarPacking.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV099OriginalFiniteCollarSectorGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV098OriginalReflectedCollarSectorGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV097OriginalSmoothPlateauGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV096OriginalEffectiveCollarCutoffGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV095OriginalUniformCollarSectorGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV094OriginalDiagonalSignedTailGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaPhaseIVOriginalNonzeroPrimeFreeSchwartzBump.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV093OriginalRestrictedCoercivityTransferGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaOriginalCollarCoercivity.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV092OriginalGreenGradientErrorGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV091OriginalGreenMomentNormalizationGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaGreenCanonical.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV090OriginalIntegratedGammaErrorGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaLiteralFormula.lean"
      - "WeilDefect/Arithmetic/ActualZetaCorrelationInverseAttachment.lean"
      - "WeilDefect/Arithmetic/ActualZetaCorrelationFourierAgreement.lean"
      - "WeilDefect/Arithmetic/ActualZetaCorrelationRegularity.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV089OriginalGammaQuadraticTailGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV086OriginalPhysicalWeilLimitGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaPhaseIVOriginalMixedHermitian.lean"
      - "WeilDefect/Arithmetic/ActualZetaSmoothCorrelationRegularity.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV071GammaFinitePrelude.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV080GammaLinearEnvelopeGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV078FiniteGammaTruncationGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV079GammaDominatedLimitGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV081GammaWeightedCompactC2Gate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV082CompactC2FourierL1Gate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV083CompactC2OriginalGammaLimitGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV084OriginalPolePhysicalGate.lean"
      - "WeilDefect/Arithmetic/ActualZetaIV085OriginalPrimeFiniteGate.lean"
      - ".github/workflows/iv100-original-affine-collar-packing.yml"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: iv100-original-affine-collar-packing-${{ github.ref }}
  cancel-in-progress: false

jobs:
  original-affine-collar-packing-lean:
    runs-on: ubuntu-latest
    timeout-minutes: 150
    steps:
      - uses: actions/checkout@v4
      - name: Strict IV100 original-source preflight
        run: |
          set -euo pipefail
          grep -Fx 'leanprover/lean4:v4.34.0' lean-toolchain
          python3 - <<'PY'
          from pathlib import Path
          import re
          s=Path("WeilDefect/Arithmetic/ActualZetaIV100OriginalAffineCollarPacking.lean").read_text()
          names=[
              "neutralIV100Affine_compact",
              "neutralIV100Affine_hasDerivAt",
              "neutralIV100Affine_derivative",
              "neutralIV100Affine_integral",
              "neutralIV100Affine_mass",
              "neutralIV100Affine_energy",
              "neutralIV100Affine_energy_ratio",
              "neutralIV100Affine_mass_pos",
              "neutralIV100Pack_window",
              "neutralIV100Pack_nonoverlap",
              "neutralIV100Pack_containment",
              "neutralIV100Carrier_collars",
              "neutralIV100Carrier_disjoint",
              "neutralIV100Carrier_derivative_disjoint",
              "neutralIV100Carrier_energy_ratio",
              "neutralIV100Carrier_mass_pos",
              "neutralIV100Packed_mass_zero_iff",
              "neutralIV100Packed_margin",
              "neutralIV100Cutoff_budget",
              "neutralIV100Packed_cutoff",
          ]
          assert len(names)==len(set(names))==20
          assert set(re.findall(r"(?m)^#print axioms (\w+)$",s))==set(names)
          assert set(re.findall(r"(?m)^theorem (\w+)",s))==set(names)
          assert all(s.splitlines().count("#print axioms "+n)==1 for n in names)
          assert not re.search(r"\b(?:sorry|admit|sorryAx)\b",s)
          print("IV100 strict preflight: twenty exact original-source bridge declarations")
          PY
      - name: Install pinned Lean and Mathlib
        run: |
          set -euo pipefail
          curl -sSf https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh | sh -s -- -y
          echo "$HOME/.elan/bin" >> "$GITHUB_PATH"
          export PATH="$HOME/.elan/bin:$PATH"
          lean --version
          lake --version
          lake exe cache get
      - name: Native fresh Lean source build
        run: |
          set -euo pipefail
          mkdir -p iv100/out
          touch iv100/out/fresh.stamp
          rm -f .lake/build/lib/lean/WeilDefect/Arithmetic/ActualZetaIV100OriginalAffineCollarPacking.olean
          lake build WeilDefect.Arithmetic.ActualZetaIV100OriginalAffineCollarPacking 2>&1 | tee iv100/out/build.log
          test -s .lake/build/lib/lean/WeilDefect/Arithmetic/ActualZetaIV100OriginalAffineCollarPacking.olean
          test .lake/build/lib/lean/WeilDefect/Arithmetic/ActualZetaIV100OriginalAffineCollarPacking.olean -nt iv100/out/fresh.stamp
      - name: Exact strict named axiom audit
        run: |
          set -euo pipefail
          lake env lean WeilDefect/Arithmetic/ActualZetaIV100OriginalAffineCollarPacking.lean 2>&1 | tee iv100/out/axioms.log
          python3 - <<'PY'
          from pathlib import Path
          import json,re
          t=Path("iv100/out/axioms.log").read_text()
          names=[
              "neutralIV100Affine_compact",
              "neutralIV100Affine_hasDerivAt",
              "neutralIV100Affine_derivative",
              "neutralIV100Affine_integral",
              "neutralIV100Affine_mass",
              "neutralIV100Affine_energy",
              "neutralIV100Affine_energy_ratio",
              "neutralIV100Affine_mass_pos",
              "neutralIV100Pack_window",
              "neutralIV100Pack_nonoverlap",
              "neutralIV100Pack_containment",
              "neutralIV100Carrier_collars",
              "neutralIV100Carrier_disjoint",
              "neutralIV100Carrier_derivative_disjoint",
              "neutralIV100Carrier_energy_ratio",
              "neutralIV100Carrier_mass_pos",
              "neutralIV100Packed_mass_zero_iff",
              "neutralIV100Packed_margin",
              "neutralIV100Cutoff_budget",
              "neutralIV100Packed_cutoff",
          ]
          allowed={"propext","Classical.choice","Quot.sound"}
          found={}
          for name in names:
              full="WeilDefect."+name
              pat=re.compile(r"^'"+re.escape(full)+r"' (?:depends on axioms: \[([^\]]*)\]|does not depend on any axioms)\s*$",re.M)
              hits=list(pat.finditer(t))
              assert len(hits)==1, (full,len(hits),t[-1200:])
              axioms=({a.strip() for a in hits[0].group(1).split(",") if a.strip()}
                      if hits[0].group(1) is not None else set())
              assert axioms<=allowed,(full,axioms-allowed)
              found[full]=sorted(axioms)
          assert not re.search(r'(?m)^\s*(?:error:|.*: error:)',t)
          Path("iv100/out/receipts.json").write_text(json.dumps(found,sort_keys=True,indent=2)+"\n")
          print("IV100 twenty strict source/axiom receipts PASS")
          PY
          git rev-parse HEAD > iv100/out/commit.txt
          sha256sum WeilDefect/Arithmetic/ActualZetaIV100OriginalAffineCollarPacking.lean \
            WeilDefect/Arithmetic/ActualZetaIV099OriginalFiniteCollarSectorGate.lean \
            WeilDefect/Arithmetic/ActualZetaIV098OriginalReflectedCollarSectorGate.lean \
            WeilDefect/Arithmetic/ActualZetaIV097OriginalSmoothPlateauGate.lean \
            WeilDefect/Arithmetic/ActualZetaIV096OriginalEffectiveCollarCutoffGate.lean \
            WeilDefect/Arithmetic/ActualZetaIV095OriginalUniformCollarSectorGate.lean \
            .lake/build/lib/lean/WeilDefect/Arithmetic/ActualZetaIV100OriginalAffineCollarPacking.olean > iv100/out/sha256.txt
          sha256sum -c iv100/out/sha256.txt
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: iv100-original-affine-collar-packing-native-lean-receipts
          path: |
            iv100/out/
            .lake/build/lib/lean/WeilDefect/Arithmetic/ActualZetaIV100OriginalAffineCollarPacking.olean
          if-no-files-found: ignore
          include-hidden-files: true
