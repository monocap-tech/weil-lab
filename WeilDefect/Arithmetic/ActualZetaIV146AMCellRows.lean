/-- Assemble the row bank without any premise asserting its positivity. -/
theorem neutralIV146AllRows (i : Nat) (hi : i < 16384) :
    0 < neutralIV146Value (i:Int) ∧
    1000000 * neutralIV146Row i <
      7979648 * 1000000000 * neutralIV146Value (i:Int) := by
  have hk : i / 64 < 256 := by omega
  have hb := neutralIV146AllBlocks ⟨i / 64, hk⟩
  change (List.range 64).all
      (fun j => neutralIV146RowOK (64*(i/64)+j)) = true at hb
  have hj : i % 64 ∈ List.range 64 := List.mem_range.mpr (by omega)
  have hrow := (List.all_eq_true.mp hb) (i%64) hj
  have heq : 64*(i/64)+i%64 = i := by omega
  rw [heq] at hrow
  exact of_decide_eq_true hrow

#print axioms neutralIV146AllRows
end WeilDefect
