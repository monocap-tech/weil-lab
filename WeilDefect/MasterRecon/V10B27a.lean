import WeilDefect.MasterRecon.V10B26c

/-! V10B27a: frozen rational polynomial and coefficientwise residual.
Horner evaluation and absolute coefficient budget are defined over the
reals; rational arithmetic is checked by norm_num, not native_decide. -/
namespace WeilDefect.MasterRecon.V10B27a

open V10B26a (numPoly denPoly expPoly expTerm sinhTerm)
noncomputable def eval : List ℝ → ℝ → ℝ
  | [], _ => 0
  | c :: cs, r => c+r*eval cs r

noncomputable def budget : List ℝ → ℝ
  | [] => 0
  | c :: cs => |c|+budget cs/2

theorem budget_nonneg (cs : List ℝ) : 0 ≤ budget cs := by
  induction cs with
  | nil => simp [budget]
  | cons c cs ih => exact add_nonneg (abs_nonneg c) (div_nonneg ih (by norm_num))

theorem eval_bound (cs : List ℝ) (r : ℝ) (hr : |r| ≤ 1/2) :
    |eval cs r| ≤ budget cs := by
  induction cs with
  | nil => simp [eval,budget]
  | cons c cs ih =>
    rw [eval,budget]
    calc
      _ ≤ |c|+|r*eval cs r| := abs_add_le _ _
      _ = |c|+|r|*|eval cs r| := by rw [abs_mul]
      _ ≤ _ := by
        have hm := mul_le_mul hr ih (abs_nonneg _) (by norm_num : (0:ℝ) ≤ 1/2)
        linarith only [hm]

