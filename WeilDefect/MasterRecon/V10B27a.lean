noncomputable def q (r : ℝ) := eval qCoeffs r

set_option maxHeartbeats 2000000 in
theorem q_budget : budget qCoeffs ≤ 1 := by
  norm_num [qCoeffs,budget,abs_of_nonneg,abs_of_nonpos]

set_option maxHeartbeats 2000000 in
theorem residual_budget : budget residualCoeffs ≤ 1/(10:ℝ)^22 := by
  norm_num [residualCoeffs,budget,abs_of_nonneg,abs_of_nonpos]

set_option maxHeartbeats 4000000 in
theorem residual_identity (r : ℝ) :
    eval dCoeffs r*q r-eval nCoeffs r = eval residualCoeffs r := by
  simp only [dCoeffs,q,qCoeffs,nCoeffs,residualCoeffs,eval]
  ring

set_option maxHeartbeats 4000000 in
theorem den_identity (r : ℝ) : denPoly r = eval dCoeffs r := by
  unfold denPoly sinhTerm
  norm_num [Finset.sum_range_succ,dCoeffs,eval,Nat.factorial] <;> ring

set_option maxHeartbeats 4000000 in
theorem num_identity (r : ℝ) (hr : 0 < r) : numPoly r = eval nCoeffs r := by
  unfold numPoly expPoly expTerm
  rw [den_identity]
  apply (div_eq_iff (by positivity : 2*r ≠ 0)).mpr
  norm_num [Finset.sum_range_succ,dCoeffs,nCoeffs,eval,Nat.factorial] <;> ring

theorem frozen_kernel_bound (r : ℝ) (hr : 0 < r) (hrh : r ≤ 1/2) :
    |V10B24b.h r-q r| ≤ 1/(2:ℝ)^28 := by
  have habs : |r| ≤ 1/2 := by rwa [abs_of_pos hr]
  apply V10B26c.frozen_budget r (q r) hr hrh
  · exact (eval_bound qCoeffs r habs).trans q_budget
  · rw [num_identity r hr,den_identity,← abs_neg]
    rw [neg_sub,residual_identity]
    exact (eval_bound residualCoeffs r habs).trans residual_budget

