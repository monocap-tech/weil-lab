def t (k : ℕ) : ℤ := tBank[k]?.getD 0
def a (j : ℕ) : ℤ := aBank[j]?.getD 0

def legCoeff (j k : ℕ) : ℤ :=
  (-1:ℤ)^j*((-1:ℤ)^k*(j.choose k:ℤ)*((j+k).choose j:ℤ))

def dot (k : ℕ) : ℤ :=
  ∑ j ∈ Finset.range 64, a j*legCoeff j k

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem coefficient_check (k : Fin 64) : t k = dot k := by
  fin_cases k <;> decide

theorem scale_pos : 0 < scale := by decide

noncomputable def TP : ℤ[X] :=
  ∑ k ∈ Finset.range 64, C (t k)*X^k

noncomputable def LP : ℤ[X] :=
  ∑ j ∈ Finset.range 64, C (a j*(-1:ℤ)^j)*shiftedLegendre j

theorem TP_coeff (k : ℕ) :
    TP.coeff k = if k < 64 then t k else 0 := by
  unfold TP
  rw [Polynomial.finsetSum_coeff]
  simp only [Polynomial.coeff_C_mul_X_pow]
  by_cases hk : k<64
  · rw [if_pos hk,Finset.sum_eq_single k]
    · simp
    · intro j _ hj
      simp [Ne.symm hj]
    · exact fun h => False.elim (h (Finset.mem_range.mpr hk))
  · rw [if_neg hk]
    apply Finset.sum_eq_zero
    intro j hj
    have hne : k ≠ j := by
      intro he
      exact hk (he ▸ Finset.mem_range.mp hj)
    simp [hne]

theorem LP_coeff (k : ℕ) : LP.coeff k = dot k := by
  unfold LP dot
  rw [Polynomial.finsetSum_coeff]
  apply Finset.sum_congr rfl
  intro j _
  rw [Polynomial.coeff_C_mul,Polynomial.coeff_shiftedLegendre]
  unfold legCoeff
  ring

theorem dot_high_zero (k : ℕ) (hk : 64 ≤ k) : dot k=0 := by
  unfold dot
  apply Finset.sum_eq_zero
  intro j hj
  have hjk : j<k := (Finset.mem_range.mp hj).trans_le hk
  simp [legCoeff,Nat.choose_eq_zero_of_lt hjk]

theorem polynomial_identity : TP=LP := by
  ext k
  rw [TP_coeff,LP_coeff]
  by_cases hk : k<64
  · rw [if_pos hk]
    exact coefficient_check ⟨k,hk⟩
  · rw [if_neg hk,dot_high_zero k (by omega)]

